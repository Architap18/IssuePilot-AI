# backend/.env.example
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real keys.

# Optional. Without this, the GitHub REST API allows 60 requests/hour (unauthenticated).
# With a personal access token the limit rises to 5,000/hour.
# Create one at: https://github.com/settings/tokens
# Scopes needed: none (public repos only) — a fine-grained token with no extra permissions works.
GITHUB_TOKEN=

# Required for Phase 2 AI analysis (POST /api/analyze).
# Get a free key at: https://console.groq.com/keys  (no credit card required)
# Model used: llama-3.1-8b-instant (free tier: 30 req/min, 14,400 req/day)

GROQ_API_KEY=your_groq_api_key_here
# Optional. Change the port the Express server listens on (default: 3000).
# PORT=3000
